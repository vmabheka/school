# MobiSchola — environment configuration
# Copy this file to `.env` (or export these as real environment variables)
# and fill in real values before running in production.

# ── Institution branding (each deployment can customise these) ────────
SCHOOL_NAME=Excel Group of Schools
SCHOOL_MOTTO=Wea Sono la Cremma Della Terra
SCHOOL_ADDRESS=
SCHOOL_PHONE=
SCHOOL_EMAIL=
CURRENCY_SYMBOL=$

# ── Software branding (FIXED — not editable in the UI) ────────────────
# MobiSchola branding is fixed for site administrators. These variables are
# deployment-level only: set them at install time if a different build is
# needed. They are excluded from the Appearance page and theme sync.
SOFTWARE_NAME=MobiSchola
SOFTWARE_BYLINE=By Edutechweb 0772577666
SOFTWARE_TAGLINE=Manage smarter—even offline.
SOFTWARE_VERSION=2.5.0

# Flask session/CSRF secret — MUST be changed for production
SECRET_KEY=change-this-to-a-long-random-string

# offline = standalone/local school PC, online = server-hosted alongside WordPress
DEPLOYMENT_MODE=online

# Database — SQLite is fine for small/offline deployments.
# For the crm.egs.ac.zw online deployment, point this at the same MySQL server
# used by WordPress (a *separate* database from the WP one), e.g.:
# DATABASE_URL=mysql+pymysql://egs_flask_user:STRONG_PASSWORD@localhost/egs_flask
DATABASE_URL=sqlite:///excel_schools.db

# WordPress REST API base that this Flask app pushes/pulls sync data to.
# Must match the site's REST namespace: <site>/wp-json/excel-schools/v2
SYNC_ENDPOINT=https://crm.egs.ac.zw/wp-json/excel-schools/v2

# Shared secret — MUST be identical to the "Sync API Key" configured in
# WordPress Admin -> Excel Schools -> Sync Center -> Settings
SYNC_API_KEY=replace-with-the-same-key-used-in-wordpress
