# Copy to .env.production. Never commit the real file.
DEPLOYMENT_MODE=online
SECRET_KEY=REPLACE_WITH_OUTPUT_OF_python_-c_import_secrets_print_secrets_token_urlsafe_64
ADMIN_USERNAME=school-admin
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_16_PLUS_CHARACTER_ADMIN_PASSWORD

# PostgreSQL container settings. Use long, unique values.
POSTGRES_DB=excel_schools
POSTGRES_USER=excel_schools
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://excel_schools:REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD@db:5432/excel_schools

# Public deployment and reverse-proxy behavior.
APP_PORT=8000
TRUST_PROXY=true
SESSION_LIFETIME_MINUTES=480
MAX_UPLOAD_MB=16
# Institution branding — override per deployment.
SCHOOL_NAME=Excel Group of Schools
SCHOOL_MOTTO=Wea Sono la Cremma Della Terra
SCHOOL_ADDRESS=
SCHOOL_PHONE=
SCHOOL_EMAIL=
SOFTWARE_NAME=MobiSchola
SOFTWARE_BYLINE=By Edutechweb 0772577666
SOFTWARE_TAGLINE=Manage smarter—even offline.
SOFTWARE_VERSION=2.5.0
CURRENCY_SYMBOL=$

# WordPress REST namespace and shared API key.
SYNC_ENDPOINT=https://crm.egs.ac.zw/wp-json/excel-schools/v2
SYNC_API_KEY=REPLACE_WITH_THE_EXACT_WORDPRESS_SYNC_API_KEY

# Comma-separated browser origins. Leave empty unless browser JavaScript on
# another origin must call the Flask API directly.
CORS_ORIGINS=https://crm.egs.ac.zw

# Gunicorn tuning (compose substitutes these into the command).
WEB_WORKERS=2
WEB_THREADS=4
WEB_TIMEOUT=120
